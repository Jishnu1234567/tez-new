# Contact form delivery (https://web3forms.com).
# Get a free access key with the inbox address that should receive enquiries,
# then copy this file to .env and paste the key below. The key is safe to ship in
# the browser bundle: it can only send form messages to that inbox.
VITE_WEB3FORMS_KEY=

# Visitor analytics (Cloudflare Web Analytics, free and cookie-free).
# Cloudflare dashboard > Analytics & Logs > Web Analytics > Add a site > thetezco.com,
# then copy the token from the snippet it shows ("token": "...") and paste it below.
# Leave empty to build without analytics.
CF_ANALYTICS_TOKEN=
